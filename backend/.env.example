# Copy this file to .env and fill in real values. Never commit .env.

# SQLite by default (no install needed). For Postgres use e.g.
# postgresql://user:password@localhost:5432/wanderwise
DATABASE_URL=sqlite:///./wanderwise.db

# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters. With COOKIE_SECURE=true the server won't start on a weak one.
JWT_SECRET=change-me

# Sessions last JWT_EXPIRE_MINUTES and renew while the user is active,
# up to SESSION_MAX_DAYS after they logged in.
JWT_EXPIRE_MINUTES=60
SESSION_MAX_DAYS=7

# Set to true in production (HTTPS only)
COOKIE_SECURE=false

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Third-party keys (used by upcoming features)
LLM_API_KEY=your-key-here
# Server key for the Geocoding API (map locations, A12) and Places API (New) (hotel suggestions
# on the Stay tab). See README, "Maps setup". Leave it empty to save plans without map locations
# and to skip hotel suggestions (adding your own hotel still works).
MAPS_API_KEY=
WEATHER_API_KEY=your-key-here
