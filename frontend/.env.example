VITE_API_URL=/api

# Google Maps browser key for the Map tab (A12). See README, "Maps setup".
# VITE_ values are built into the JavaScript, so anyone can read this key: restrict it in Google Cloud.
# Leave it empty to run without the map.
VITE_GOOGLE_MAPS_KEY=
# Optional Map ID from Google Cloud (Map management). Empty uses Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
